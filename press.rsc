13:["$","section",null,{"className":"doc-section","id":"descriptions","aria-labelledby":"descriptions-title","children":[["$","p",null,{"className":"kicker","children":"Ready to quote"}],["$","h2",null,{"id":"descriptions-title","children":"Descriptions"}],["$","h3",null,{"style":{"marginTop":22},"children":"One line"}],["$","div",null,{"className":"quote-block","children":["$","p",null,{"children":"Apparent is a calm daily loop for parents and kids on their own devices: you set the day, your child sees one clear next step, you approve what needs a look, and rewards update on both screens."}]}],["$","h3",null,{"style":{"marginTop":28},"children":"A paragraph"}],["$","div",null,{"className":"quote-block","children":[["$","p",null,{"children":"Apparent is a calm daily loop for parents and kids on their own devices."}],["$","p",null,{"children":"You set the day. Your child sees one clear next step. You approve what needs a look. Rewards update on both screens."}],["$","p",null,{"children":"We built it on published research, which meant leaving most things out. No streaks. No reminders sent to your child. No algorithm deciding what a task is worth. You set the stars, you choose the rewards, and the app keeps the math honest."}]]}]]}]
