1c:["$","section",null,{"className":"doc-section","id":"screen-time","aria-labelledby":"screen-time-title","children":[["$","p",null,{"className":"kicker","children":"Optional, uses Apple's Screen Time"}],["$","h2",null,{"id":"screen-time-title","children":"Screen Time and the Daily Unlock"}],["$","p",null,{"className":"doc-intro","children":"A Daily Unlock can hold the apps you choose on your child's device until today's tasks are handled. The hold lifts for the rest of the day and comes back at midnight."}],["$","ul",null,{"className":"doc-list","children":[["$","li",null,{"children":"You set it up on your child's device, behind a parent check. The apps you choose never leave that device."}],["$","li",null,{"children":"With your child's Apple ID in your Family Sharing group, your child can't switch it off without you. Without Family Sharing, whoever holds the device can turn it off in Settings."}],["$","li",null,{"children":"If the app can't tell where things stand, it leaves the hold as it was. A finished task needs a connection to count."}],["$","li",null,{"children":"Skip it any time: a Daily Unlock still works as a family agreement."}]]}],["$","div",null,{"className":"callout","children":[["$","strong",null,{"children":"Use Apple's Downtime?"}],["$","p",null,{"children":"Downtime can lock Apparent too. Add Apparent to Always Allowed on your child's device; the app walks you through it."}]]}]]}]
