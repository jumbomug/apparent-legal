2f:["$","details","Can both parents use it? What if we're separated?",{"children":[["$","summary",null,{"children":["Can both parents use it? What if we're separated?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"Yes. Any number of parents or guardians can join a family, and none of them is ever a paid seat. Everyone sees the same day."}]]}]
30:["$","details","Who is Finn?",{"children":[["$","summary",null,{"children":["Who is Finn?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"Finn is the calm teal character on your child's screen, drawn by Zac Schmidt, who created all of Apparent's art. Finn keeps your child company, never judges, never hands out stars, and never speaks on serious screens."}]]}]
