20:["$","section",null,{"className":"section","id":"faq","aria-labelledby":"faq-title","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"section-head center","children":[["$","p",null,{"className":"kicker","children":"Questions"}],["$","h2",null,{"id":"faq-title","children":"Questions families ask."}]]}],["$","div",null,{"className":"faq","children":[["$","details","Does my child need an account?",{"children":[["$","summary",null,{"children":["Does my child need an account?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"No. Children never create accounts or passwords. You add your child by name and school level, give permission, and connect their device with a short-lived code or a QR code."}]]}],["$","details","What devices do we need?",{"children":[["$","summary",null,{"children":["What devices do we need?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"An iPhone or iPad for you, and an iPhone or iPad for your child. Apparent is on the App Store, iOS only, and available in the United States."}]]}],["$","details","What does Apparent cost?",{"children":[["$","summary",null,{"children":["What does Apparent cost?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"Apparent is free for one child and every parent or guardian. Every new household gets a free first month with everything included: no payment details, nothing to cancel. After it, the free plan keeps the daily loop for every child you've added. Adding another child needs the Family plan, monthly or yearly, which covers every child. The App Store shows the prices."}]]}],["$","details","Do I have to approve everything?",{"children":[["$","summary",null,{"children":["Do I have to approve everything?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"No. You choose which tasks you want to check. Everything else completes when your child holds the button."}]]}],["$","details","What's the difference between stars and a Daily Unlock?",{"children":[["$","summary",null,{"children":["What's the difference between stars and a Daily Unlock?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"Stars add up and get spent on rewards your family picks. A Daily Unlock is a daily privilege, like Tech Time, that opens when chosen tasks are handled and relocks tomorrow. When a task counts toward an unlock, it earns no stars unless you give it some."}]]}],["$","details","Can rewards be something other than screen time?",{"children":[["$","summary",null,{"children":["Can rewards be something other than screen time?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"Yes. Rewards are whatever your family decides: a movie night, choosing dinner, an outing, allowance. The app never assumes what the reward is."}]]}],["$","details","How does the Screen Time hold work, and is it required?",{"children":[["$","summary",null,{"children":["How does the Screen Time hold work, and is it required?",["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":["$","path",null,{"d":"M12 5v14M5 12h14"}]}]]}],["$","p",null,{"children":"It's optional. A Daily Unlock can hold apps you choose on your child's device until today's tasks are done. It uses Apple's Screen Time, and you set it up on your child's device behind a parent check. For the version a child can't switch off without you, your child's Apple ID needs to be in your Family Sharing group."}]]}],"$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33"]}]]}]}]
