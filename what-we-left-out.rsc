true","children":"Support"}]]}],["$","a",null,{"aria-current":"$undefined","className":"tab","href":"/about","children":[["$","svg",null,{"aria-hidden":"true","className":"icon ","viewBox":"0 0 24 24","children":[["$","circle",null,{"cx":"12","cy":"12","r":"8.5"}],["$","path",null,{"d":"M12 11v5.5M12 7.8v.1"}]]}],["$","span",null,{"className":"tab-long","children":"About"}],["$","span",null,{"className":"tab-short","aria-hidden":"true","children":"About"}]]}]]}]}]}]],["$","main",null,{"id":"main-content","tabIndex":-1,"children":[["$","header",null,{"aria-labelledby":"refusal-title","className":"stage band","data-sky":"morning","id":"$undefined","tabIndex":"$undefined","children":[null,["$","div",null,{"aria-hidden":"true","className":"stage-body"}],null,null,["$","div",null,{"className":"wrap stage-content","children":[["$","p",null,{"className":"kicker","children":"The Refusal List"}],["$","h1",null,{"id":"refusal-title","children":["Built on research, ",["$","em",null,{"children":"which meant leaving things out."}]]}],["$","p",null,{"className":"band-lede","children":"What we left out, and what we read."}]]}]]}],["$","div",null,{"className":"doc","children":["$","div",null,{"className":"wrap doc-layout","children":[["$","nav",null,{"className":"doc-rail","aria-labelledby":"refusal-rail","children":[["$","p",null,{"id":"refusal-rail","children":"On this page"}],["$","ul",null,{"children":[["$","li",null,{"children":["$","a",null,{"href":"#asked","children":"What the research asked for"}]}],["$","li",null,{"children":["$","a",null,{"href":"#kept","children":"What we kept"}]}],["$","li",null,{"children":["$","a",null,{"href":"#our-call","children":"Our own calls"}]}],["$","li",null,{"children":["$","a",null,{"href":"#thin","children":"Where the evidence is thin"}]}],["$","li",null,{"children":["$","a",null,{"href":"#sources","children":"Sources"}]}]]}]]}],["$","article",null,{"className":"prose","children":[["$","p",null,{"className":"prose-intro","children":"Before building Apparent we read the published research on rewards, motivation, and how children's days actually go. Most of it was advice about what not to do. This page lists what we refused to build, the finding behind each refusal, and what we did instead. Where a choice was ours and not the research's, we say so."}],["$","section",null,{"className":"part","id":"asked","aria-labelledby":"asked-title","children":[["$","h2",null,{"id":"asked-title","children":"Refusals the research asked for"}],["$","section",null,{"className":"refusal","aria-labelledby":"refusal-1","children":[["$","h3",null,{"id":"refusal-1","children":[["$","span",null,{"aria-hidden":"true","children":1}],"We don't put stars on the everyday tasks."]}],["$","dl",null,{"children":[["$","dt",null,{"children":"The refusal"}],["$","dd",null,{"children":"When a task counts toward a Daily Unlock, it earns no stars unless you give it some."}],"$L12","$L13","$L14","$L15"]}]]}],"$L16","$L17","$L18","$L19"]}],"$L1a","$L1b","$L1c","$L1d"]}]]}]}]]}],"$L1e"]
12:["$","dt",null,{"children":"What we read"}]
13:["$","dd",null,{"children":["A 1999 meta-analysis of 128 experiments found that expected tangible rewards reduce intrinsic motivation for the rewarded activity. For rewards given on finishing a task, the kind a chore app uses, the effect was d = -0.36. Rewards the person didn't expect had about no effect (+0.01).",[["$","p","Deci, E. L., Koestner, R., & Ryan, R. M. (1999). A meta-analytic review of experiments examining the effects of extrinsic rewards on intrinsic motivation. Psychological Bulletin, 125(6), 627 to 668.",{"className":"source","children":["Source: ","Deci, E. L., Koestner, R., & Ryan, R. M. (1999). A meta-analytic review of experiments examining the effects of extrinsic rewards on intrinsic motivation. Psychological Bulletin, 125(6), 627 to 668.",null]}]]]}]
14:["$","dt",null,{"children":"What we did instead"}]
15:["$","dd",null,{"children":"The daily privilege is the stake. Stars are for the extra things a family chooses to reward, and a parent can give stars to any task."}]
16:["$","section",null,{"className":"refusal","aria-labelledby":"refusal-2","children":[["$","h3",null,{"id":"refusal-2","children":[["$","span",null,{"aria-hidden":"true","children":2}],"We don't let Finn hand out stars or praise."]}],["$","dl",null,{"children":[["$","dt",null,{"children":"The refusal"}],["$","dd",null,{"children":"Finn, the character, never awards stars, never evaluates, and never speaks on serious screens."}],["$","dt",null,{"children":"What we read"}],["$","dd",null,{"children":["The same meta-analysis found that verbal rewards, meaning praise, helped adults but showed no reliable effect for children (d = 0.11, not significant).",[["$","p","Deci, Koestner & Ryan (1999), above.",{"className":"source","children":["Source: ","Deci, Koestner & Ryan (1999), above.",null]}]]]}],["$","dt",null,{"children":"What we did instead"}],["$","dd",null,{"children":"A finished task gets one plain line (“Nice, Mia!”), and on the sky screen a star flies to the balance. The parent approves what needs a look. Finn keeps the child company."}]]}]]}]
17:["$","section",null,{"className":"refusal","aria-labelledby":"refusal-3","children":[["$","h3",null,{"id":"refusal-3","children":[["$","span",null,{"aria-hidden":"true","children":3}],"We don't send reminders to your child."]}],["$","dl",null,{"children":[["$","dt",null,{"children":"The refusal"}],["$","dd",null,{"children":"Your child's device receives no push notifications at all. The day is on their screen, and nobody pings them."}],["$","dt",null,{"children":"What we read"}],["$","dd",null,{"children":["Two things. First, in interviews with autistic adults about getting stuck starting or switching tasks, alarms, lists, and reminders were described as seldom helpful, while another person's direct prompt or presence was what actually helped. Second, for children who experience ordinary requests as demands, a “do your tasks” notification is itself a demand, and demands can trigger refusal rather than action. That second finding is mostly lived experience collected by families and practitioners, not controlled trials, and we say that plainly.",[["$","p","Buckle, K. L., Leadbitter, K., Poliakoff, E., & Gowen, E. (2021). First-hand accounts of autistic inertia. Autism in Adulthood.",{"className":"source","children":["Source: ","Buckle, K. L., Leadbitter, K., Poliakoff, E., & Gowen, E. (2021). First-hand accounts of autistic inertia. Autism in Adulthood.",[" ",["$","a",null,{"href":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8314008/","children":"www.ncbi.nlm.nih.gov/pmc/articles/PMC8314008/"}]]]}],["$","p","PDA Society. Collaborative and Proactive Solutions.",{"className":"source","children":["Source: ","PDA Society. Collaborative and Proactive Solutions.",[" ",["$","a",null,{"href":"https://www.pdasociety.org.uk/what-helps-guides/pda-approaches/collaborative-and-proactive-solutions/","children":"www.pdasociety.org.uk/what-helps-guides/pda-approaches/collaborative-and-proactive-solutions/"}]]]}]]]}],["$","dt",null,{"children":"What we did instead"}],["$","dd",null,{"children":"One Next up card, the full list below it, and a Help button the child can press at any time."}]]}]]}]
18:["$","section",null,{"className":"refusal","aria-labelledby":"refusal-4","children":[["$","h3",null,{"id":"refusal-4","children":[["$","span",null,{"aria-hidden":"true","children":4}],"We don't compare children, and we don't keep streaks."]}],["$","dl",null,{"children":[["$","dt",null,{"children":"The refusal"}],["$","dd",null,{"children":"No leaderboards, no sibling rankings, no streak counters, no “you lost it” messages anywhere in the app."}],["$","dt",null,{"children":"What we read"}],["$","dd",null,{"children":["In adolescents, how controlled a teen feels predicts depressive symptoms more strongly than what the parent intended. Supporting a child's sense of choice helps; pushing independence does not.",[["$","p","Tanaka, A., Tamura, A., Ishii, R., et al. (2023). Longitudinal association between maternal autonomy support and controlling parenting and adolescents' depressive symptoms. Journal of Youth and Adolescence, 52, 1058 to 1073.",{"className":"source","children":["Source: ","Tanaka, A., Tamura, A., Ishii, R., et al. (2023). Longitudinal association between maternal autonomy support and controlling parenting and adolescents' depressive symptoms. Journal of Youth and Adolescence, 52, 1058 to 1073.",[" ",["$","a",null,{"href":"https://doi.org/10.1007/s10964-022-01722-1","children":"doi.org/10.1007/s10964-022-01722-1"}]]]}],["$","p","Beyers, W., Soenens, B., & Vansteenkiste, M. (2024). European Journal of Developmental Psychology.",{"className":"source","children":["Source: ","Beyers, W., Soenens, B., & Vansteenkiste, M. (2024). European Journal of Developmental Psychology.",[" ",["$","a",null,{"href":"https://selfdeterminationtheory.org/wp-content/uploads/2024/03/2024_BeyersSoenensVansteenkiste_EJODP.pdf","children":"selfdeterminationtheory.org/wp-content/uploads/2024/03/2024_BeyersSoenensVansteenkiste_EJODP.pdf"}]]]}]]]}],["$","dt",null,{"children":"What we did instead"}],["$","dd",null,{"children":"A Daily Path of dots that fills in and resets each day. Each child sees only their own day."}]]}]]}]
19:["$","section",null,{"className":"refusal","aria-labelledby":"refusal-5","children":[["$","h3",null,{"id":"refusal-5","children":[["$","span",null,{"aria-hidden":"true","children":5}],"We don't let grades touch rewards."]}],["$","dl",null,{"children":[["$","dt",null,{"children":"The refusal"}],["$","dd",null,{"children":"A parent can note a grade so the child sees it on a quiet card. Grades never change stars, unlocks, or celebrations, and there are no school-system connections."}],["$","dt",null,{"children":"What we read"}],["$","dd",null,{"children":["Attaching an expected reward to school performance makes it a completion-contingent reward, the type with the measured cost above.",[["$","p","Deci, Koestner & Ryan (1999), above.",{"className":"source","children":["Source: ","Deci, Koestner & Ryan (1999), above.",null]}]]]}],["$","dt",null,{"children":"What we did instead"}],["$","dd",null,{"children":"Grades, kept in their place."}]]}]]}]
1a:["$","section",null,{"className":"part","id":"kept","aria-labelledby":"kept-title","children":[["$","h2",null,{"id":"kept-title","children":"What we kept, and why"}],["$","section",null,{"className":"refusal","aria-labelledby":"kept-chores","children":[["$","h3",null,{"id":"kept-chores","children":"We kept the chores."}],["$","dl",null,{"children":[["$","dt",null,{"children":"What we read"}],["$","dd",null,{"children":["In a study following 9,971 US children, doing chores in kindergarten predicted better prosocial behavior, academic ability, peer relationships, and life satisfaction in third grade, after accounting for sex, family income, and parents' education.",["$","p",null,{"className":"source","children":["Source: ","White, E. M., DeBoer, M. D., & Scharf, R. J. (2019). Associations between household chores and childhood self-competency. Journal of Developmental & Behavioral Pediatrics, 40(3), 176 to 182.",[" ",["$","a",null,{"href":"https://doi.org/10.1097/DBP.0000000000000637","children":"doi.org/10.1097/DBP.0000000000000637"}]]]}]]}],["$","dt",null,{"children":"What that meant for us"}],["$","dd",null,{"children":"Keep the loop. Rethink the incentive."}]]}]]}],["$","section",null,{"className":"refusal","aria-labelledby":"kept-day","children":[["$","h3",null,{"id":"kept-day","children":"We built for the day, not for a diagnosis."}],["$","dl",null,{"children":[["$","dt",null,{"children":"What we read"}],["$","dd",null,{"children":["In children with neurodevelopmental conditions, quality of life and the stress their parents report track the child's executive function and daily living skills. That load runs across ADHD, autism, dyslexia, and dyspraxia rather than belonging to any one of them.",["$","p",null,{"className":"source","children":["Source: ","Lobato-Ruiz, V., Romero-Ayuso, D., Toledano-González, A., & Triviño-Juárez, J. M. (2025). Quality of life and parental stress related to executive functioning, sensory processing, and activities of daily living in children and adolescents with neurodevelopmental disorders. PeerJ, 13, e19326.",[" ",["$","a",null,{"href":"https://doi.org/10.7717/peerj.19326","children":"doi.org/10.7717/peerj.19326"}]]]}]]}],["$","dt",null,{"children":"What that meant for us"}],["$","dd",null,{"children":"One clear next step, tasks grouped by time of day, a Quiet look for children who want less on the screen, and starter tasks written as supports for getting through the day."}]]}]]}]]}]
1b:["$","section",null,{"className":"part","id":"our-call","aria-labelledby":"our-call-title","children":[["$","h2",null,{"id":"our-call-title","children":"Refusals that were our call"}],["$","p",null,{"children":"The research didn't tell us to do these. We did them anyway, and we'd rather say so than dress them up as findings."}],["$","ul",null,{"className":"calls","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Holding apps is optional."}]," A Daily Unlock also works as a family agreement, with no apps held at all."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Every parent or guardian is free, always."}]," Two homes, a grandparent, a nanny. Adults are never a paid seat."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Stuck has a button."}]," Asking for help never counts against a child."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No ads, no third-party analytics or tracking SDKs, no selling data."}]," ","We ask your permission before your child's device connects."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No algorithm sets the stakes."}]," You decide what a task is worth."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Nothing is sold on your child's device."}]," No cosmetics, no themes, no upsells."]}],["$","li",null,{"children":["$","strong",null,{"children":"No chat, no social features, no AI telling you how to parent."}]}],["$","li",null,{"children":[["$","strong",null,{"children":"No kid debit cards."}]," Allowance is a reward you define, not a financial product."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Nothing red, nothing sad."}]," A sent-back task says “Your parent asked you to try this one again.”"]}]]}]]}]
1c:["$","section",null,{"className":"part","id":"thin","aria-labelledby":"thin-title","children":[["$","h2",null,{"id":"thin-title","children":"Where the evidence is thin"}],["$","p",null,{"children":"We want to be clear about what we don't know."}],["$","div",null,{"className":"thin","children":["$","ul",null,{"children":[["$","li",null,{"children":"The idea that reward systems backfire specifically for neurodivergent children is not well supported in mainstream autism-education research. The strongest case is for demand-avoidant children, and most of that is lived experience rather than trials. Demand avoidance can be measured as a trait; whether it is a diagnosis of its own is still contested."}],["$","li",null,{"children":"Nobody has tested Apparent in a study. We designed from published findings; we have not measured outcomes, and we won't claim any."}],["$","li",null,{"children":"Most families see children disengage from systems like this around week three. We have no mechanism that prevents it."}]]}]}],["$","p",null,{"style":{"marginTop":24},"children":["If you think we read something wrong, tell us at"," ",["$","a",null,{"href":"mailto:hello@apparentfamily.com","children":"hello@apparentfamily.com"}],". The list is the product, and we'd rather fix it than defend it."]}]]}]
1d:["$","section",null,{"className":"part","id":"sources","aria-labelledby":"sources-title","children":[["$","h2",null,{"id":"sources-title","children":"Sources"}],["$","ol",null,{"className":"sources","children":[["$","li","Deci, E. L., Koestner, R., & Ryan, R. M. (1999). A meta-analytic review of experiments examining the effects of extrinsic rewards on intrinsic motivation. Psychological Bulletin, 125(6), 627 to 668.",{"children":["Deci, E. L., Koestner, R., & Ryan, R. M. (1999). A meta-analytic review of experiments examining the effects of extrinsic rewards on intrinsic motivation. Psychological Bulletin, 125(6), 627 to 668.",null]}],["$","li","Buckle, K. L., Leadbitter, K., Poliakoff, E., & Gowen, E. (2021). First-hand accounts of autistic inertia. Autism in Adulthood.",{"children":["Buckle, K. L., Leadbitter, K., Poliakoff, E., & Gowen, E. (2021). First-hand accounts of autistic inertia. Autism in Adulthood.",[" ",["$","a",null,{"href":"https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8314008/","children":"www.ncbi.nlm.nih.gov/pmc/articles/PMC8314008/"}]]]}],["$","li","PDA Society. Collaborative and Proactive Solutions.",{"children":["PDA Society. Collaborative and Proactive Solutions.",[" ",["$","a",null,{"href":"https://www.pdasociety.org.uk/what-helps-guides/pda-approaches/collaborative-and-proactive-solutions/","children":"www.pdasociety.org.uk/what-helps-guides/pda-approaches/collaborative-and-proactive-solutions/"}]]]}],["$","li","Tanaka, A., Tamura, A., Ishii, R., et al. (2023). Longitudinal association between maternal autonomy support and controlling parenting and adolescents' depressive symptoms. Journal of Youth and Adolescence, 52, 1058 to 1073.",{"children":["Tanaka, A., Tamura, A., Ishii, R., et al. (2023). Longitudinal association between maternal autonomy support and controlling parenting and adolescents' depressive symptoms. Journal of Youth and Adolescence, 52, 1058 to 1073.",[" ",["$","a",null,{"href":"https://doi.org/10.1007/s10964-022-01722-1","children":"doi.org/10.1007/s10964-022-01722-1"}]]]}],["$","li","Beyers, W., Soenens, B., & Vansteenkiste, M. (2024). European Journal of Developmental Psychology.",{"children":["Beyers, W., Soenens, B., & Vansteenkiste, M. (2024). European Journal of Developmental Psychology.",[" ",["$","a",null,{"href":"https://selfdeterminationtheory.org/wp-content/uploads/2024/03/2024_BeyersSoenensVansteenkiste_EJODP.pdf","children":"selfdeterminationtheory.org/wp-content/uploads/2024/03/2024_BeyersSoenensVansteenkiste_EJODP.pdf"}]]]}],["$","li","White, E. M., DeBoer, M. D., & Scharf, R. J. (2019). Associations between household chores and childhood self-competency. Journal of Developmental & Behavioral Pediatrics, 40(3), 176 to 182.",{"children":["White, E. M., DeBoer, M. D., & Scharf, R. J. (2019). Associations between household chores and childhood self-competency. Journal of Developmental & Behavioral Pediatrics, 40(3), 176 to 182.",[" ",["$","a",null,{"href":"https://doi.org/10.1097/DBP.0000000000000637","children":"doi.org/10.1097/DBP.0000000000000637"}]]]}],["$","li","Lobato-Ruiz, V., Romero-Ayuso, D., Toledano-González, A., & Triviño-Juárez, J. M. (2025). Quality of life and parental stress related to executive functioning, sensory processing, and activities of daily living in children and adolescents with neurodevelopmental disorders. PeerJ, 13, e19326.",{"children":["Lobato-Ruiz, V., Romero-Ayuso, D., Toledano-González, A., & Triviño-Juárez, J. M. (2025). Quality of life and parental stress related to executive functioning, sensory processing, and activities of daily living in children and adolescents with neurodevelopmental disorders. PeerJ, 13, e19326.","$L1f"]}]]}]]}]
1e:["$","footer",null,{"className":"site-footer","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"footer-grid","children":[["$","div",null,{"className":"footer-intro","children":[["$","a",null,{"className":"wordmark","href":"/","aria-label":"Apparent home","children":["Apparent",["$","span",null,{"aria-hidden":"true","children":"."}]]}],["$","p",null,{"children":"A calm daily loop for parents and kids on their own devices. In beta on iPhone and iPad."}]]}],["$","nav",null,{"className":"footer-nav","aria-label":"Apparent","children":[["$","strong",null,{"children":"Apparent"}],["$","a",null,{"href":"/#how-it-works","children":"How it works"}],["$","a",null,{"href":"/what-we-left-out","children":"What we left out"}],["$","a",null,{"href":"/#faq","children":"Questions"}],["$","a",null,{"href":"/about","children":"About"}],["$","a",null,{"href":"/press","children":"Press"}]]}],["$","nav",null,{"className":"footer-nav","aria-label":"Help and legal","children":[["$","strong",null,{"children":"Help"}],["$","a",null,{"href":"/support","children":"Support"}],["$","a",null,{"href":"/privacy.html","children":"Privacy policy"}],["$","a",null,{"href":"mailto:support@apparentfamily.com","children":"support@apparentfamily.com"}],["$","a",null,{"href":"mailto:hello@apparentfamily.com","children":"hello@apparentfamily.com"}]]}]]}],["$","div",null,{"className":"footer-bottom","children":[["$","span",null,{"children":"© 2026 Bear Audio LLC"}],["$","span",null,{"children":"Apparent Family and Finn are trademarks of Bear Audio LLC"}]]}]]}]}]
